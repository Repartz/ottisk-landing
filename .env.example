# ============================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ OTTISK
# Скопируйте в .env.local и заполните реальными значениями
# ============================================

# === Firebase Configuration (взять из Firebase Console) ===
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# === Яндекс.Метрика ===
# 8-значный номер счётчика из metrika.yandex.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# === URL сайта ===
NEXT_PUBLIC_SITE_URL=https://ottisk.vercel.app

# === Админ-панель ===
ADMIN_PASSWORD=GHEYNJK35ifj@

# === Форма заявки ===
# Поддерживает 2 транспорта. Хотя бы один должен быть настроен.
# Resend рекомендуется (HTTPS, не блокируется провайдерами в РФ).

# Вариант 1: Resend (HTTPS API)
# 1. Регистрация: https://resend.com → Sign up
# 2. API Keys → Create API Key (Sandbox для тестов)
# 3. Скопируй ключ (начинается с re_...) в RESEND_API_KEY
# В sandbox без своего домена письма приходят только на email, под которым регистрировался.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Вариант 2: Gmail SMTP (App Password) — fallback
# 1. Включи 2FA: https://myaccount.google.com/security
# 2. Создай App Password: https://myaccount.google.com/apppasswords
# 3. Скопируй 16-значный пароль (без пробелов) в SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ottiskcomp@gmail.com
SMTP_PASS=
# Куда отправлять заявки. По умолчанию = SMTP_USER
CONTACT_TO=ottiskcomp@gmail.com
